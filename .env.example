# OpenAlex API Configuration
# Sign up at https://openalex.org/ to get a free API key or use mailto for polite pool
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_MAILTO=your_email@institution.edu

# Optional Scholarly APIs
SEMANTIC_SCHOLAR_API_KEY=

# Pipeline Configuration
LOG_LEVEL=INFO
CACHE_DIR=data/cache
CACHE_ENABLED=true
CACHE_TTL_DAYS=7

# Model / Inference Settings (Offline first / Local transformers)
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu
MAX_RETRIES=3
REQUEST_TIMEOUT=15
